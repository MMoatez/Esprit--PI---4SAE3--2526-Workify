# ==========================================
# Smart-Free GestionMess - .gitignore
# ==========================================

# ---------- Node / Angular / Next.js ----------
node_modules/
dist/
.angular/cache
.next/
out/
npm-debug.log*
yarn-error.log*

# ---------- Java / Maven / Spring Boot ----------
target/
*.jar
*.war
*.class
.mvn/
*.log

# ---------- Python ----------
__pycache__/
*.py[cod]
*.pyo
venv/
.env
*.egg-info/

# ---------- Docker ----------
docker-compose.override.yml

# ---------- IDEs and editors ----------
.idea/
.vscode/
*.iml
*.ipr
*.iws
.project
.classpath
.settings/
*.sublime-workspace
*.sublime-project

# ---------- OS files ----------
.DS_Store
Thumbs.db
desktop.ini

# ---------- Environment ----------
.env
.env.local
.env.*.local

# ---------- Data / Databases ----------
data/*.db
*.mv.db
*.trace.db
*.csv
*.sql

# ---------- Misc ----------
*.swp
*.swo
*~
