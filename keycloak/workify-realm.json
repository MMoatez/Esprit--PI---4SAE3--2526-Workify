{
  "realm": "workify",
  "enabled": true,
  "displayName": "Workify",
  "registrationAllowed": false,
  "resetPasswordAllowed": true,
  "rememberMe": true,
  "verifyEmail": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "sslRequired": "none",
  "accessTokenLifespan": 86400,
  "ssoSessionMaxLifespan": 86400,
  "roles": {
    "realm": [
      { "name": "admin",      "description": "Platform administrator" },
      { "name": "freelancer", "description": "Freelancer user" },
      { "name": "client",     "description": "Client user" }
    ]
  },
  "clients": [
    {
      "clientId": "workify-frontend",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:4200/*",
        "http://192.168.1.154:4200/*"
      ],
      "webOrigins": [
        "http://localhost:4200",
        "http://192.168.1.154:4200"
      ],
      "protocol": "openid-connect",
      "attributes": {
        "access.token.lifespan": "86400"
      }
    },
    {
      "clientId": "admin-cli",
      "enabled": true,
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": true,
      "secret": "admin-cli-secret",
      "protocol": "openid-connect"
    }
  ],
  "users": [
    {
      "username": "admin",
      "email": "admin@workify.com",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Admin",
      "lastName": "Workify",
      "credentials": [
        {
          "type": "password",
          "value": "admin123",
          "temporary": false
        }
      ],
      "realmRoles": ["admin"]
    }
  ]
}
