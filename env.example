# ==========================================
# Workify (SmartFreelance) — Variables d'environnement
# ==========================================
# Copiez ce fichier en ".env" et ajustez les
# valeurs selon votre environnement.
#
# NE JAMAIS commiter le fichier .env réel !
# ==========================================


# ──────────────────────────────────────────
# 1. BASES DE DONNÉES
# ──────────────────────────────────────────

# --- PostgreSQL (user-service, formation-service, Keycloak) ---
POSTGRES_USER=workify
POSTGRES_PASSWORD=votre_mot_de_passe_securise
POSTGRES_DB=workify_users
POSTGRES_PORT=5432

# --- MySQL (communication, event, feedback, moatez, project services) ---
MYSQL_ROOT_PASSWORD=
MYSQL_ALLOW_EMPTY_PASSWORD=yes
MYSQL_PORT=3306

# URLs JDBC des bases MySQL par microservice
# (createDatabaseIfNotExist=true crée automatiquement la BD)
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=


# ──────────────────────────────────────────
# 2. KEYCLOAK (Authentification / SSO)
# ──────────────────────────────────────────
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=votre_admin_password
KEYCLOAK_SERVER_URL=http://localhost:8180
KEYCLOAK_ISSUER_URI=http://localhost:8180/realms/workify
KEYCLOAK_REALM=workify
KEYCLOAK_CLIENT_ID=workify-frontend


# ──────────────────────────────────────────
# 3. SERVICE DISCOVERY (Eureka)
# ──────────────────────────────────────────
EUREKA_CLIENT_SERVICEURL_DEFAULTZONE=http://eureka-server:8761/eureka/


# ──────────────────────────────────────────
# 4. CLÉS API — Intelligence Artificielle
# ──────────────────────────────────────────

# --- Google Gemini (moatez-service, project-service) ---
GEMINI_API_KEY=votre_cle_gemini_api

# --- OpenAI / OpenRouter (user-service) ---
OPENROUTER_API_KEY=votre_cle_openrouter

# --- OpenAI / Groq (project-service, event-service) ---
OPENAI_API_KEY=votre_cle_openai
GROQ_API_KEY=votre_cle_groq

# --- HuggingFace (rag-service, feedback-service) ---
HUGGINGFACE_API_KEY=votre_cle_huggingface


# ──────────────────────────────────────────
# 5. STRIPE (Paiement — moatez-service)
# ──────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_votre_cle_stripe
STRIPE_WEBHOOK_SECRET=whsec_votre_webhook_secret
STRIPE_CURRENCY=eur


# ──────────────────────────────────────────
# 6. RECAPTCHA (user-service / frontend)
# ──────────────────────────────────────────
RECAPTCHA_SITE_KEY=votre_site_key_recaptcha
RECAPTCHA_SECRET_KEY=votre_secret_key_recaptcha


# ──────────────────────────────────────────
# 7. ML SERVICE (FastAPI — Python)
# ──────────────────────────────────────────
ML_MODEL_PATH=./models
ML_API_PORT=8000


# ──────────────────────────────────────────
# 8. RECEIPT AI SERVICE (OCR — Python)
# ──────────────────────────────────────────
TESSERACT_CMD=/usr/bin/tesseract


# ──────────────────────────────────────────
# 9. UPLOADS & FICHIERS
# ──────────────────────────────────────────
USER_PROFILE_UPLOAD_DIR=/app/uploads


# ──────────────────────────────────────────
# 10. PORTS DES SERVICES (référence)
# ──────────────────────────────────────────
# Eureka Server       : 8761
# API Gateway          : 8888
# User Service         : 8081
# Formation Service    : 8082
# Communication Service: 8084
# ML Service (proxy)   : 8085
# Feedback Service     : 8086
# Moatez Service       : 8089
# Project Service      : 8063
# Event Service        : 8096
# RAG Service          : 8097
# Receipt AI Service   : 8000
# Keycloak             : 8180
# Open Resume (Next.js): 3000
# Frontend (Angular)   : 4200
